RONIN_RPC_URLS=https://api.roninchain.com/rpc,https://2020.rpc.thirdweb.com
# Verified on-chain and pinned in src/launchpad/pins.json.
EXPECTED_LAUNCHPAD=0xa8e9fdf57bbd991c3f494273198606632769db99
EXPECTED_NFT_CONTRACT=0x6d1bc5247ca99D917d91EC52Dbbb5EF6c2435107
STAGE_INDEX=2
FEE_MODE=race
# Minimum bid used only in race mode. Raise together with MAX_PRIORITY_FEE_GWEI.
RACE_MIN_PRIORITY_FEE_GWEI=20
MAX_PRIORITY_FEE_GWEI=200
