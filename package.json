{
  "name": "ronin-launchpad-mint-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bot": "tsx src/cli.ts",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "discover": "tsx scripts/discover.ts",
    "test:fork": "tsx scripts/validate-fork.ts",
    "setup:env": "tsx scripts/setup-env.ts"
  },
  "dependencies": {
    "dotenv": "17.4.2",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
